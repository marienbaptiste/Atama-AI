# atama-AI — environment overrides (OPTIONAL) and the complete settings inventory.
#
# You normally do NOT need this file. Configuration is done in the app's settings page
# and stored in settings.json (git-ignored). Environment variables are an optional
# override layer for automation/CI: resolution is defaults -> settings.json -> env.
#
# Every key config.py reads appears here with its default; a test asserts this file,
# config.py and the settings-page schema list the same keys. Keep them in sync.
#
# If you do use it: copy to .env (git-ignored) and never commit real values.
#
# Names here are bare because this file is ours. Overrides taken from the PROCESS environment
# must instead be prefixed ATAMA_ (ATAMA_CLAUDE_MODEL=...): Claude Code exports CLAUDE_EFFORT
# and friends of its own, and they leaked into our config when read bare (found 2026-09-09).

# ---- Account & tokens (all optional; the app runs with zero, one, or both SRS sources) ----
# Why a token at all when Claude uses MCP? MCP is only the transport that lets Claude *call*
# a tool. The tool (the MCP server) still has to authenticate to WaniKani/Bunpro with YOUR
# token. Tokens never enter the claude process itself — only the specific MCP server that
# needs them, via the env block of its mcp.json entry.
#
# READ-ONLY: this app never writes to WaniKani or Bunpro (spec §5, ADR-021).
# Create the WaniKani token with NO write permissions ticked:
#   https://www.wanikani.com/settings/personal_access_tokens
#   leave unticked: assignments:start, reviews:create, study_materials:create,
#                   study_materials:update, user:update
WANIKANI_TOKEN=
# Bunpro -> Settings -> API -> "Account API Token". Sent as `Authorization: Token token=...`.
# Unofficial, unscoped, full-account credential: the read-only client/tool layers (spec §0) are
# the defence. This app never asks for your Bunpro email or password and never reads cookies.
BUNPRO_API_TOKEN=

# ---- Claude CLI auth ----
# Leave empty to use your interactive `claude` login (run `claude`, then /login, on the machine
# that runs the backend — inside WSL2 on Windows). Or run `claude setup-token` and paste here.
# NEVER set ANTHROPIC_API_KEY in this environment: it silently overrides subscription auth and
# bills the API. The orchestrator allowlists the child env, and `make doctor` hard-fails if the
# variable is present in the shell.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Brain (ADR-027: the brain is a provider behind an interface) ----
BRAIN_PROVIDER=claude-cli        # implemented: claude-cli. A local model / other vendor means a new backend/brain/ module.
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium             # low|medium|high|xhigh|max. Measured median first-token / opening turn: low 2.75s/8.6s, medium 2.14s/5.8s, high 3.75s/19.2s. Set high if you prefer depth over speed.
CLAUDE_FALLBACK_MODEL=haiku
CLAUDE_REPLACE_SYSTEM_PROMPT=true   # true = --system-prompt (Sensei is the whole prompt). false appends to Claude Code's coding-agent prompt, which makes her answer as "an AI assistant".
CLAUDE_TURN_TIMEOUT_S=60
CLAUDE_CWD=                      # empty = platform default OUTSIDE the repo (~/.atama-ai/claude-cwd on Windows, ~/.local/state/atama-ai/claude-cwd elsewhere). Never inside the repo (Claude Code walks up for CLAUDE.md); not under %LOCALAPPDATA% with Store Python (MSIX virtualisation).

# ---- Network (loopback only — the mic stream and your SRS profile go over this socket) ----
HOST=127.0.0.1
PORT=8000
VOICEVOX_URL=http://127.0.0.1:50021
SEARXNG_URL=http://127.0.0.1:8888  # self-hosted search for the tutor's topic tool (ADR-028). NOT IMPLEMENTED yet — needs a live instance to verify (ROADMAP V0.11).

# ---- Voice (VOICEVOX) ----
VOICEVOX_SPEAKER=1               # base style id; real ids come from GET /speakers at startup
VOICEVOX_SPEED_SCALE=0.9
VOICEVOX_INTONATION_SCALE=1.0
# Emotion -> voice table (spec §7). style ids must exist for the chosen speaker or they fall
# back to VOICEVOX_SPEAKER with the scalar overrides only.
EMOTION_HAPPY=style=,speed=0.95,pitch=0.02,intonation=1.15
EMOTION_THINKING=style=,speed=0.85,pitch=-0.01,intonation=0.90
EMOTION_SURPRISED=style=,speed=1.00,pitch=0.04,intonation=1.30
EMOTION_SERIOUS=style=,speed=0.85,pitch=-0.03,intonation=0.85

# ---- Speech detection ----
WHISPER_MODEL=large-v3           # fallback: medium (int8) if whisper alone exceeds ~4.5 GB VRAM
WHISPER_COMPUTE_TYPE=int8_float16
VAD_SILENCE_MS=600
VAD_MIN_SPEECH_MS=300
BARGEIN_THRESHOLD_FACTOR=2.0     # VAD threshold multiplier while the avatar is speaking (self-barge-in guard)
BARGEIN_MIN_SPEECH_MS=250
PLAYBACK_ONSET_IGNORE_MS=150

# ---- Latency / VRAM guards ----
FILLER_AFTER_MS=1200
LATENCY_WARN_S=3.0
VRAM_WARN_GB=10

# ---- Display ----
SUBTITLES=jp                     # jp | off
STATUS_HEARTBEAT_S=30

# ---- Files ----
SETTINGS_FILE=settings.json
LOG_DIR=logs
CACHE_DIR=.cache
SRS_CACHE_TTL_S=3600
SRS_FETCH_BUDGET_S=10
