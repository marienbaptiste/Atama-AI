{
  "name": "atama-ai-frontend",
  "private": true,
  "version": "0.3.0",
  "description": "The avatar page: Vite + vanilla TypeScript, no framework (ADR-009).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/srs-grep.mjs",
    "build": "tsc --noEmit && vite build",
